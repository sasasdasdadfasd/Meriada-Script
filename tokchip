		l.Font = Enum.Font.GothamMedium
		l.TextSize = size
		l.TextColor3 = Color3.new(1, 1, 1)
		l.TextStrokeTransparency = 0.45
		l.Visible = false
		l.Parent = espGui
		return l
	end
	o.name = label(12)
	o.dist = label(11)
	o.hpBack = Instance.new("Frame")
