local function espCreate()
	local o = {}
	o.box = Instance.new("Frame")
	o.box.BackgroundTransparency = 1
	o.box.BorderSizePixel = 0
	o.box.Visible = false
	o.box.Parent = espGui
	o.stroke = Instance.new("UIStroke")
	o.stroke.Thickness = 1.5
	o.stroke.LineJoinMode = Enum.LineJoinMode.Miter
